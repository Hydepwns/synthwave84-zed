    "high_contrast": {
      "$comment": "Enhanced visibility - colors more saturated/vibrant",
      "background.deep": "#1a1420",
      "background.surface": "#1f1a2a",
      "background.elevated": "#251f30",
      "background.active": "#5a4b7a",
      "foreground.primary": "#ffffff",
      "border.default": "#6b74b8",
      "border.focused": "#cc00cc",
      "syntax.function": "#00f5f0",
      "syntax.heading": "#00f5f0",
      "syntax.keyword": "#ffdc00",
      "syntax.declaration": "#ff6bd6",
      "syntax.string": "#ff7700",
      "syntax.type": "#ff6bd6",
      "syntax.variable": "#ff6bd6",
      "syntax.tag": "#ff6bd6",
      "syntax.markup": "#ff6bd6",
      "syntax.list": "#ff6bd6",
      "syntax.constant": "#ff6b5d",
      "syntax.number": "#ff6b5d",
      "syntax.parameter": "#ff6b5d",
      "syntax.comment": "#9da5d5",
      "syntax.success": "#5fffaf",
      "syntax.info": "#00e5ff",
