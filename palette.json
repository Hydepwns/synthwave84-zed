{
  "$comment": "Centralized color palette for Synthwave84 theme variants",
  "base": {
    "background": {
      "deep": "#241b2f",
      "surface": "#262335",
      "elevated": "#2a2139",
      "active": "#463465"
    },
    "foreground": {
      "primary": "#ffffff",
      "muted": "#ffffff80",
      "placeholder": "#ffffff40"
    },
    "border": {
      "default": "#495495",
      "focused": "#880088",
      "transparent": "#00000000"
    }
  },
  "syntax": {
    "$comment": "Base colors for Classic variant. Soft/High Contrast derive from these.",
    "function": "#36f9f6",
    "heading": "#36f9f6",
    "keyword": "#fede5d",
    "declaration": "#ff7edb",
    "string": "#ff8b39",
    "type": "#ff7edb",
    "variable": "#ff7edb",
    "tag": "#ff7edb",
    "markup": "#ff7edb",
    "list": "#ff7edb",
    "constant": "#f97e72",
    "number": "#f97e72",
    "parameter": "#f97e72",
    "comment": "#848bbd",
    "success": "#72f1b8",
    "info": "#03edf9",
    "error": "#fe4450"
  },
  "terminal": {
    "black": "#241b2f",
    "red": "#fe4450",
    "green": "#72f1b8",
    "yellow": "#fede5d",
    "blue": "#03edf9",
    "magenta": "#ff7edb",
    "cyan": "#36f9f6",
    "white": "#ffffff"
  },
  "players": [
    "#f97e72",
    "#36f9f6",
    "#ff7edb",
    "#fede5d",
    "#72f1b8",
    "#03edf9",
    "#ff8b39",
    "#b893ce"
