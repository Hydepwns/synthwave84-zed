    "delta": {
      "$comment": "Standalone palette ported from the 'delta' scheme in fluoromachine.nvim (maxmx03, MIT). Functions are yellow, keywords pink. Not derived from the Synthwave base -- excluded from 'make derive'.",
      "$upstream": "https://github.com/maxmx03/fluoromachine.nvim/blob/main/lua/fluoromachine/colors/delta.lua",
      "background.deep": "#251d2b",
      "background.surface": "#2b2233",
      "background.elevated": "#352a3f",
      "background.active": "#492949",
      "foreground.primary": "#efeffd",
      "foreground.muted": "#efeffd80",
      "foreground.placeholder": "#efeffd40",
      "border.default": "#925393",
      "border.focused": "#ff67d4",
      "syntax.function": "#edff98",
      "syntax.heading": "#c0ff98",
      "syntax.keyword": "#ff67d4",
      "syntax.declaration": "#ff67d4",
      "syntax.string": "#d598ff",
      "syntax.type": "#c0ff98",
      "syntax.variable": "#efeffd",
      "syntax.tag": "#ff67d4",
      "syntax.markup": "#ffd298",
      "syntax.list": "#d598ff",
      "syntax.constant": "#ff98b3",
      "syntax.number": "#98fffb",
      "syntax.parameter": "#ffd298",
      "$comment.comment": "Upstream #925393 is 2.81:1 on this background and fails the 3.0 gate; lifted to 3.55:1.",
      "syntax.comment": "#a562a6",
      "syntax.success": "#c0ff98",
      "syntax.info": "#98fffb",
      "syntax.error": "#ff98b3",
      "terminal.black": "#251d2b",
      "terminal.red": "#ff98b3",
      "terminal.green": "#c0ff98",
      "terminal.yellow": "#edff98",
      "terminal.blue": "#d598ff",
      "terminal.magenta": "#ff67d4",
      "terminal.cyan": "#98fffb",
      "terminal.white": "#efeffd",
      "players": [
        "#ff67d4",
        "#98fffb",
        "#c0ff98",
        "#edff98",
        "#d598ff",
        "#ff98b3",
        "#ffd298",
        "#b279b3"
      ]
    }
  }
}
