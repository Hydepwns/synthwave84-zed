  "variants": {
    "soft": {
      "$comment": "Lower contrast - colors shifted lighter/more pastel",
      "background.deep": "#2a2139",
      "background.surface": "#2e2a3e",
      "background.elevated": "#332e42",
      "background.active": "#4e4570",
      "foreground.primary": "#f0f0f0",
      "border.default": "#5a5f8d",
      "border.focused": "#9933aa",
      "syntax.function": "#5af5f3",
      "syntax.heading": "#5af5f3",
      "syntax.keyword": "#fee380",
      "syntax.declaration": "#ff92e0",
      "syntax.string": "#ffa15a",
      "syntax.type": "#ff92e0",
      "syntax.variable": "#ff92e0",
      "syntax.tag": "#ff92e0",
      "syntax.markup": "#ff92e0",
      "syntax.list": "#ff92e0",
      "syntax.constant": "#fa9890",
      "syntax.number": "#fa9890",
      "syntax.parameter": "#fa9890",
      "syntax.comment": "#848bbd",
      "syntax.success": "#85f3c3",
      "syntax.info": "#33f0fc",
      "syntax.error": "#fe6670"
